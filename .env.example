# GOTCHA Trust Verification Engine - Environment Configuration

# Persistence & Queues
DATABASE_URL=sqlite:///./gotcha.db
# DATABASE_URL=postgresql://gotcha:gotcha@localhost:5432/gotcha
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & Auth
JWT_SECRET=change-this-to-a-secure-random-secret-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs & LLM (Optional - system works in deterministic offline mode if absent)
GITHUB_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Cryptographic Attestation (Ed25519) - auto-generated if empty
ATTESTATION_PRIVATE_KEY=
ATTESTATION_PUBLIC_KEY=

# Scan Limits
MAX_FILES=500
MAX_TOTAL_SIZE_MB=50
MAX_FILE_SIZE_KB=1024

# Observability
ENVIRONMENT=development
SENTRY_DSN=
